@article{ashuach2026clr,
  title={Can Latent Reasoning Drive {LLM} Outputs Without a Trace?},
  author={Ashuach, Tomer and Gekhman, Zorik and Caciularu, Avi and Ram, Ori and Herzig, Jonathan},
  journal={arXiv preprint arXiv:2611.31015},
  year={2026},
  month={11},
  arxiv={2611.31015},
  abbr={Preprint},
  website={https://tomerashuach.github.io/clr/},
  url={https://arxiv.org/abs/2611.31015},
  preview={clr.png},
  selected={true},
  abstract={We ask whether complete latent reasoning is deep enough for a model to pursue a hidden objective that requires reasoning. We train a model whose chain of thought appears to solve the given task, while a latent multi-step computation decides its answer, and a strong monitor does not flag it.}
}

@inproceedings{peleg2026geometry,
  title={The Geometry of Ignorance: Detecting Suppressed Knowledge in {LLMs} through Activation Fragmentation},
  author={Peleg, Adar and Alsheich, Dvir and Ashuach, Tomer and Mendelson, Avi},
  booktitle={Findings of the Association for Computational Linguistics: EMNLP 2026},
  year={2026},
  month={11},
  abbr={EMNLP Findings 2026},
  arxiv={2611.05272},
  url={https://arxiv.org/abs/2611.05272},
  code={https://github.com/AdarPeleg/geometry-of-ignorance},
  preview={geometry.png},
  abstract={A model that refuses to answer may still hold recoverable knowledge. We measure the geometry of hidden-state differences between a query and its anonymized paraphrase, and show that genuine knowledge forms a tight cluster while ignorance fragments. This gives an attack-free proxy for how robust unlearning is.}
}

@inproceedings{nikankin2026reasoning,
  title={Reasoning Models Know What's Important, and Encode It in Their Activations},
  author={Nikankin, Yaniv and Tutek, Martin and Ashuach, Tomer and Rosenfeld, Jonathan and Belinkov, Yonatan},
  booktitle={Proceedings of the Conference on Language Modeling (COLM) 2026},
  year={2026},
  abbr={COLM 2026},
  arxiv={2604.18307},
  website={https://technion-cs-nlp.github.io/reasoning-importance/},
  url={https://arxiv.org/abs/2604.18307},
  preview={reasoning_importance.png},
  abstract={Which steps of a long reasoning chain matter for the final answer? We show that model activations identify important reasoning steps better than the tokens themselves, and that models encode a step's importance internally, even before generating the steps that follow.}
}

@inproceedings{ashuach2026masked,
  title={Masked by Consensus: Disentangling Privileged Knowledge in LLM Correctness},
  author={Ashuach, Tomer and Ein-Dor, Liat and Gretz, Shai and Katz, Yoav and Belinkov, Yonatan},
  booktitle={Proceedings of the 64th Annual Meeting of the Association for Computational Linguistics: ACL 2026},
  year={2026},
  month={07},
  arxiv={2604.12373},
  abbr={ACL 2026 (Oral)},
  website={https://technion-cs-nlp.github.io/Privileged-Knowledge/},
  url={https://arxiv.org/abs/2604.12373},
  pdf={Masked_by_Consensus__Disentangling_Privileged_Knowledge_in_LLM_Correctness.pdf},
  preview={pk.png},
  selected={true},
  abstract={We explore whether large language models possess privileged internal knowledge about their own correctness, analogous to human introspection. By evaluating models on conflicting predictions, we discover that LLMs exhibit a domain-specific intuition for factual knowledge tasks that external observers cannot access.}
}

@inproceedings{ashuach2025crisp,
  title={{CRISP}: Persistent Concept Unlearning via Sparse Autoencoders},
  author={Ashuach, Tomer and Arad, Dana and Mueller, Aaron and Tutek, Martin and Belinkov, Yonatan},
  booktitle={Proceedings of the 64th Annual Meeting of the Association for Computational Linguistics: ACL 2026},
  year={2026},
  month={07},
  arxiv={2508.13650},
  abbr={ACL 2026 (Oral)},
  website={https://technion-cs-nlp.github.io/CRISP/},
  url={https://arxiv.org/abs/2508.13650},
  pdf={Concept_Unlearning_via_SAE_ACL_2026.pdf},
  code={https://github.com/tomerashuach/CRISP},
  preview={crisp.png},
  selected={true},
  abstract={We introduce CRISP, a parameter-efficient method leveraging sparse autoencoders to achieve persistent concept unlearning in LLMs. By automatically identifying and suppressing salient features, CRISP successfully removes harmful knowledge while maintaining model utility.}
}

@inproceedings{ashuach2024revs,
  title={{REVS}: Unlearning Sensitive Information in Language Models via Rank Editing in the Vocabulary Space},
  author={Ashuach, Tomer and Tutek, Martin and Belinkov, Yonatan},
  booktitle={Findings of the Association for Computational Linguistics: ACL 2025},
  year={2025},
  month={May},
  abbr={ACL Findings 2025},
  arxiv={2406.09325},
  website={https://technion-cs-nlp.github.io/REVS/},
  url={https://technion-cs-nlp.github.io/REVS/},
  pdf={REVS__Unlearning_Sensitive_Information_in_Language_Models_via_Rank_Editing_in_the_Vocabulary_Space_ACL_2025.pdf},
  code={https://github.com/tomerashuach/REVS},
  preview={revs.png},
  selected={true},
  abstract={We propose REVS, a non-gradient-based method that unlearns sensitive information from language models by identifying and modifying a small subset of relevant neurons. REVS achieves robust unlearning and resists extraction attacks while preserving the model's underlying integrity.}
}
